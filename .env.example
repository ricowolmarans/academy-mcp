# Canvas LMS instance base URL (no trailing slash)
CANVAS_BASE_URL=https://your-institution.instructure.com

# Personal Access Token (Account > Settings > New Access Token)
CANVAS_ACCESS_TOKEN=your_personal_access_token_here

# Optional: default account ID for course creation
# CANVAS_ACCOUNT_ID=1

# Optional: request timeout ms (default 30000)
# CANVAS_TIMEOUT_MS=30000

# Optional: max retries (default 3)
# CANVAS_MAX_RETRIES=3
